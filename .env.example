# Modèle du fichier .env : le copier en .env et choisir ses propres valeurs.
# Le fichier .env est lu par docker compose et par le serveur Spring ; il n'est jamais versionné.
POSTGRES_DB=messagerie
POSTGRES_USER=messagerie
POSTGRES_PASSWORD=a_changer
POSTGRES_PORT=5432

# Secret de signature des JWT (D-008) : 256 bits aléatoires encodés en Base64.
# À générer avec : openssl rand -base64 32
JWT_SECRET=a_generer
